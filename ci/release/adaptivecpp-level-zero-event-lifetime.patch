+void ze_queue::release_completed_dependencies() {
+  _pending_dependencies.erase(
+      std::remove_if(_pending_dependencies.begin(), _pending_dependencies.end(),
+                     [](const pending_dependencies& pending) {
+                       return pending.completion->is_complete();
+                     }),
+      _pending_dependencies.end());
+}
+
+void ze_queue::prepare_submission(const std::shared_ptr<dag_node_event>& evt) {
+  release_completed_dependencies();
+  // Allocate before the asynchronous append. Once it succeeds, updating the
+  // queue's last event must not throw and release live native wait handles.
+  _enqueued_synchronization_ops.reserve(1);
+  _pending_dependencies.push_back({evt, _enqueued_synchronization_ops});
+}
+
+void ze_queue::cancel_submission() {
+  _pending_dependencies.pop_back();
 }
 
