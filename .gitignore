build/
build-*/
*.plot2

# Diagnostic bundles from scripts/collect-gpu-diag.sh, and the logs people
# drop in the repo root while debugging. These carry hostnames, device
# inventories and — when they come from someone else's machine — that
# person's home directory path. Nothing in this class should ever reach a
# commit. The script redacts home paths on the way out; this is the backstop
# for everything it cannot see.
xchplot2-diag-*.txt
debug.log
.cache/
compile_commands.json
.vscode/
.idea/

# cargo build output (top-level workspace; keygen-rs/target/ has its own
# .gitignore).
target/

# nsys / nsight-compute profile artifacts
*.nsys-rep
*.qdrep
*.qdstrm
*.ncu-rep

# pos2-chip is fetched here automatically by CMake at configure time.
# See CMakeLists.txt → FetchContent_Declare(pos2_chip).
third_party/
docs/

# Local-only scratch (container build contexts, repro logs, throwaway
# test artifacts). Never committed.
tmp/

# Local-only feature backlog (mirror of cuda-only's same file).
FEATURES.md
